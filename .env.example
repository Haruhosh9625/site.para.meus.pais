# =============================================================================
# DS Espetos — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
#
# NENHUM segredo deste arquivo chega ao navegador: todas as variáveis abaixo
# são lidas apenas no servidor (src/server/env.ts). Não existe nenhuma
# variável NEXT_PUBLIC_* com credencial no projeto.
#
# O `.env` está no .gitignore. Nunca faça commit dele.
# =============================================================================

# -----------------------------------------------------------------------------
# OBRIGATÓRIAS
# -----------------------------------------------------------------------------

# Conexão com o PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
#
# No Supabase, use as duas strings que o painel oferece em
# Project Settings > Database > Connection string:
#
#   DATABASE_URL  a do POOLER (porta 6543, com ?pgbouncer=true). É a que a
#                 aplicação usa — em servidores sem estado, abrir conexão
#                 direta a cada requisição esgota o limite do banco.
#   DIRECT_URL    a DIRETA (porta 5432). É a que as migrations usam; o
#                 pooler não dá conta de comandos de DDL.
#
# Exemplo (troque SENHA e a região):
#   DATABASE_URL="postgresql://postgres.<ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
#   DIRECT_URL="postgresql://postgres.<ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://dsespetos:senha@localhost:5432/dsespetos?schema=public"

# Conexão sem pooler, usada só pelas migrations. É obrigatória: fora do
# Supabase, repita aqui a mesma string da DATABASE_URL.
DIRECT_URL="postgresql://dsespetos:senha@localhost:5432/dsespetos?schema=public"

# Segredo da aplicação. Gere um valor aleatório longo e NUNCA reutilize
# entre ambientes:
#   openssl rand -base64 48
SESSION_SECRET=""

# URL pública da aplicação, sem barra no final.
# Usada para montar links de e-mail e a URL de retorno dos pagamentos.
APP_URL="http://localhost:3000"


# Fuso horário da loja.
#
# TODO cálculo de horário — expediente e agendamento de retirada — acontece
# neste fuso. "18:00" no horário de funcionamento significa 18:00 no balcão.
# Servidores de nuvem rodam em UTC por padrão; sem esta variável, um
# expediente das 18:00 às 23:00 viraria 15:00 às 20:00 na prática.
# O padrão do código já é America/Sao_Paulo — declare aqui se a loja
# estiver em outro fuso.
TZ="America/Sao_Paulo"


# -----------------------------------------------------------------------------
# SUPABASE — banco de dados e login
#
# Onde achar cada valor, no painel https://supabase.com/dashboard:
#
#   SUPABASE_URL              Project Settings > Data API > Project URL
#   SUPABASE_PUBLISHABLE_KEY  Project Settings > API Keys > "publishable"
#                             (a chave legada "anon" também serve; se for
#                              usá-la, o nome da variável é SUPABASE_ANON_KEY)
#   senha do banco            Project Settings > Database > Database password
#                             — só aparece na criação. Perdida, é só clicar em
#                             "Reset database password" e usar a nova.
#
# A chave publicável é PÚBLICA por natureza: em qualquer aplicação Supabase
# ela vai para o navegador. Não dá permissão nenhuma no banco — as tabelas
# ficam trancadas pela migration `fecha_api_publica`.
#
# A chave de SERVIÇO (service_role) NÃO é usada por este projeto e não deve
# ser colocada aqui. Nenhum fluxo precisa dela; quanto menos segredo em
# circulação, melhor.
# -----------------------------------------------------------------------------

SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Quem guarda as senhas: supabase | local
#
#   supabase  o Supabase Auth guarda a credencial, faz o hash e envia os
#             e-mails de confirmação e de redefinição. É o modo de produção.
#   local     a senha fica neste banco, com hash scrypt e tabela de sessões.
#             Serve para desenvolvimento e para `npm run test:e2e` rodar sem
#             depender de rede.
#
# Deixando vazio, o padrão é `supabase` quando as duas variáveis acima estão
# preenchidas e `local` quando não estão. EM PRODUÇÃO o modo local só entra
# se estiver declarado aqui de propósito: uma variável esquecida no deploy
# derruba a aplicação com uma mensagem clara em vez de voltar a guardar
# senhas no banco sem ninguém perceber.
AUTH_PROVIDER=""

# ---- o que configurar no painel do Supabase --------------------------------
#
# 1. Authentication > URL Configuration
#      Site URL:       https://seu-dominio.com
#      Redirect URLs:  https://seu-dominio.com/redefinir-senha
#                      https://seu-dominio.com/login
#    Sem isso, o link de redefinição de senha não volta para o site.
#
# 2. Authentication > Sign In / Providers > Email
#      "Confirm email" ligado  = mais seguro, e o cadastro passa a exigir o
#                                clique no e-mail antes do primeiro acesso
#                                (as telas já tratam esse caso).
#      "Confirm email" desligado = o cliente entra na hora.
#
# 3. Project Settings > Authentication > SMTP Settings
#    O servidor de e-mail padrão do Supabase é limitado a poucas mensagens
#    por hora e não serve para produção. Para confirmação de e-mail e
#    redefinição de senha funcionarem de verdade, configure um SMTP
#    próprio (Resend, SendGrid, Amazon SES, Brevo...).


# -----------------------------------------------------------------------------
# SESSÃO
# -----------------------------------------------------------------------------

# Duração da sessão em dias (padrão: 30).
SESSION_TTL_DAYS="30"


# -----------------------------------------------------------------------------
# PAGAMENTOS — escolha UM provedor
#
# Valores aceitos: manual | mercadopago | stripe | asaas | pagbank
#
# Preencha somente o bloco do provedor escolhido. Trocar de gateway é trocar
# esta variável: nenhuma tela ou rota da aplicação muda.
# -----------------------------------------------------------------------------

PAYMENT_PROVIDER="manual"

# ---- manual: PIX direto na sua chave, sem gateway ---------------------------
# Gera um BR Code EMV válido (o "PIX copia e cola") com a chave da loja.
# A confirmação do pagamento NÃO é automática: vem do webhook assinado
# (abaixo) ou da baixa manual feita por um administrador no painel.
PIX_KEY=""
PIX_RECEIVER_NAME="DS ESPETOS"
PIX_RECEIVER_CITY="SAO PAULO"

# Segredo do webhook do provedor manual. Sem ele, a rota
# /api/webhooks/payments/manual fica desativada (responde 503).
#   openssl rand -hex 32
MANUAL_WEBHOOK_SECRET=""

# ---- Mercado Pago -----------------------------------------------------------
# Access Token: painel > Suas integrações > sua aplicação > Credenciais
# Webhook secret: painel > Webhooks > "Assinatura secreta"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ---- Stripe -----------------------------------------------------------------
# Secret key: dashboard > Developers > API keys (sk_live_... / sk_test_...)
# Webhook secret: dashboard > Developers > Webhooks > seu endpoint (whsec_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Asaas ------------------------------------------------------------------
# API key: painel > Integrações > Chave de API
# Webhook token: o token que você define ao cadastrar o webhook
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
# Produção: https://api.asaas.com/v3 | Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_BASE_URL="https://api.asaas.com/v3"

# ---- PagBank (PagSeguro) ----------------------------------------------------
PAGBANK_TOKEN=""
PAGBANK_WEBHOOK_TOKEN=""
# Produção: https://api.pagseguro.com | Sandbox: https://sandbox.api.pagseguro.com
PAGBANK_BASE_URL="https://api.pagseguro.com"


# -----------------------------------------------------------------------------
# ADMINISTRADOR INICIAL (usado pelo seed)
#
# Sem SEED_ADMIN_PASSWORD o seed NÃO cria administrador nenhum — não existe
# senha padrão embutida no código. Alternativa recomendada em produção:
# rodar `npm run admin:create`, que pede a senha no terminal sem eco e sem
# gravá-la em arquivo.
# -----------------------------------------------------------------------------

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PHONE=""


# -----------------------------------------------------------------------------
# UPLOAD DE IMAGENS (fotos dos produtos)
#
# Grava no disco local. Em plataformas serverless (Vercel, por exemplo) o
# disco é efêmero: use ENABLE_UPLOADS="false" e informe a URL de uma imagem
# hospedada (S3, R2, Cloudinary) direto no campo de foto do produto.
# -----------------------------------------------------------------------------

ENABLE_UPLOADS="true"
UPLOAD_DIR="public/uploads"


# -----------------------------------------------------------------------------
# NOTIFICAÇÕES
#
# O canal interno (avisos dentro do site) funciona sempre. Os canais externos
# só ligam quando você implementar o envio em
# src/server/services/notifications.ts — ligar a flag sem implementar faz a
# notificação ser registrada como FAILED, com o motivo no log.
# -----------------------------------------------------------------------------

NOTIFY_EMAIL_ENABLED="false"
NOTIFY_WHATSAPP_ENABLED="false"
NOTIFY_PUSH_ENABLED="false"

# Opcional: recebe um POST em JSON a cada notificação gerada.
# Serve para plugar automações externas (n8n, Make, Zapier) sem alterar código.
NOTIFY_WEBHOOK_URL=""


# -----------------------------------------------------------------------------
# TESTES
# -----------------------------------------------------------------------------

# URL contra a qual `npm run test:e2e` roda.
TEST_BASE_URL="http://localhost:3000"
